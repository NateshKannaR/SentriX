# ====================================================================
# SENTINEL 360 — Environment Variables Configuration
# ====================================================================

# Optional Supabase Database & Authentication Integration
# If omitted or left blank, the application automatically operates in
# zero-dependency local persistent demonstration mode (localStorage + memory).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Default Center Coordinates for Map
VITE_DEFAULT_LAT=12.9716
VITE_DEFAULT_LNG=77.5946
